# ── Web app (client-exposed) ────────────────────────────────────────────────
# Bohr BOT Chain testnet (chain id 968). Mainnet is 677 / https://rpc.botchain.ai.
NEXT_PUBLIC_CHAIN_ID=968
NEXT_PUBLIC_RPC_URL=https://rpc.bohr.life
# Deployed Rung registry address. Leave empty to run the UI in preview/demo mode.
NEXT_PUBLIC_RUNG_ADDRESS=
# Block the Rung registry was deployed at. Bounds log scans (0 = scan from genesis).
NEXT_PUBLIC_RUNG_DEPLOY_BLOCK=0
# Public origin of the app (used to build metadata links).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Server-side ─────────────────────────────────────────────────────────────
# Metadata pinning adapter. Hosted production needs a durable pinning endpoint.
# Without one, metadata stays local in development or when ALLOW_LOCAL_METADATA
# is explicitly enabled for a localhost-only test.
PINNING_ENDPOINT=
PINNING_TOKEN=
# Local testnet only: permit file-backed metadata in production mode when
# NEXT_PUBLIC_APP_URL is localhost/127.0.0.1/::1. Leave disabled on hosted sites.
ALLOW_LOCAL_METADATA=false

# ── Bohr testnet deployment ─────────────────────────────────────────────────
# Protocol admin controls the shared asset allowlist and creation pause.
RUNG_ADMIN=
# Bohr testnet only: Deploy.s.sol refuses to broadcast on any chain other than 968.
RUNG_RPC_URL=https://rpc.bohr.life
# Use a 0x-prefixed EVM private key. Keep this value only in ignored local .env.
RUNG_PRIVATE_KEY=

# ── Local Anvil only ────────────────────────────────────────────────────────
# Disposable key/address printed by your local Anvil instance. Never use a real key.
ANVIL_TEST_KEY=
ANVIL_ADMIN_ADDRESS=

# ── Indexer / reconciliation ────────────────────────────────────────────────
# Optional hosted Postgres for persistent Ponder state. Leave empty to use local PGlite.
DATABASE_URL=
PONDER_CHAIN_ID=968
PONDER_RPC_URL_968=https://rpc.bohr.life
RUNG_ADDRESS=
RUNG_DEPLOY_BLOCK=0
RPC_URL=https://rpc.bohr.life
EXPECTED_CHAIN_ID=968
# Ponder GraphQL endpoint for web discovery and reconciliation (optional)
INDEXER_URL=http://localhost:42069/graphql
